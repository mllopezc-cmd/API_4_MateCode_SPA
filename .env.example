VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_APP_ID=replace_with_firebase_app_id

# Opcionales para las funciones que los necesiten
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Habilitar solo cuando la API de Vercel esté operativa.
VITE_ENABLE_EMAIL_SUMMARY=false

# ============================================
# API de correo - variables privadas del servidor
# ============================================
# Configurar en Vercel, entorno Production.
# Nunca colocar credenciales reales en este archivo.
# Nunca utilizar el prefijo VITE_ para secretos.

EMAIL_DELIVERY_MODE=disabled

# Amazon SES Sandbox
AWS_REGION=us-east-2
AWS_ROLE_ARN=
AWS_SES_FROM_EMAIL=

# Firebase Admin - credencial privada JSON
FIREBASE_SERVICE_ACCOUNT_JSON=
